{
  "_comment": [
    "ECS Fargate task definition for the MCP Server.",
    "Replace all REPLACE_WITH_... placeholders before registering.",
    "",
    "Key points:",
    "  - taskRoleArn needs bedrock-agent-runtime:Retrieve for the search_travel_guides tool",
    "  - TRAVEL_API_URL uses the private IP of the travel-api ECS task",
    "  - MCP_TRANSPORT is set to 'http' so the server listens on port 8200 via SSE",
    "  - No ALB needed — agent connects directly via private IP",
    "",
    "Register with:",
    "  aws ecs register-task-definition --cli-input-json file://deploy/task-def-mcp-server.json"
  ],

  "family": "mcp-server",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],

  "cpu":    "256",
  "memory": "512",

  "executionRoleArn": "arn:aws:iam::REPLACE_WITH_ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn":      "arn:aws:iam::REPLACE_WITH_ACCOUNT_ID:role/agentTaskRole",

  "containerDefinitions": [
    {
      "name":  "mcp-server",
      "image": "REPLACE_WITH_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/mcp-server:latest",

      "portMappings": [
        { "containerPort": 8200, "protocol": "tcp" }
      ],

      "environment": [
        { "name": "AWS_REGION",     "value": "us-east-1" },
        { "name": "MCP_TRANSPORT",  "value": "http" },
        { "name": "MCP_HOST",       "value": "0.0.0.0" },
        { "name": "MCP_PORT",       "value": "8200" },
        { "name": "TRAVEL_API_URL", "value": "http://REPLACE_WITH_TRAVEL_API_PRIVATE_IP:9000" }
      ],

      "secrets": [
        {
          "name":      "AWS_ACCESS_KEY_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:REPLACE_WITH_ACCOUNT_ID:secret:travel-concierge/AWS_ACCESS_KEY_ID"
        },
        {
          "name":      "AWS_SECRET_ACCESS_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:REPLACE_WITH_ACCOUNT_ID:secret:travel-concierge/AWS_SECRET_ACCESS_KEY"
        },
        {
          "name":      "BEDROCK_KB_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:REPLACE_WITH_ACCOUNT_ID:secret:travel-concierge/BEDROCK_KB_ID"
        }
      ],

      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group":         "/ecs/mcp-server",
          "awslogs-region":        "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },

      "essential": true
    }
  ]
}
