{
  "_comment": [
    "IAM policy for the ECS task role (agentTaskRole).",
    "Attach this to the role your agent container runs as.",
    "",
    "Permissions granted:",
    "  bedrock:InvokeModel                    — call_bedrock() (Converse API)",
    "  bedrock:InvokeModelWithResponseStream  — call_bedrock_stream() (Converse Stream)",
    "  bedrock-agent-runtime:RetrieveAndGenerate  — RAG Knowledge Base queries",
    "  secretsmanager:GetSecretValue          — pull secrets at task start",
    "",
    "Create the role in AWS console or with:",
    "  aws iam create-role --role-name agentTaskRole \\",
    "      --assume-role-policy-document file://deploy/iam-agent-trust.json",
    "  aws iam put-role-policy --role-name agentTaskRole \\",
    "      --policy-name AgentTaskPolicy \\",
    "      --policy-document file://deploy/iam-agent-task-role.json"
  ],

  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BedrockInvoke",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-micro-v1:0",
        "arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-lite-v1:0"
      ]
    },
    {
      "Sid": "BedrockRAG",
      "Effect": "Allow",
      "Action": [
        "bedrock-agent-runtime:RetrieveAndGenerate",
        "bedrock-agent-runtime:Retrieve"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecretsManager",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:us-east-1:REPLACE_WITH_ACCOUNT_ID:secret:travel-concierge/*"
    }
  ]
}
